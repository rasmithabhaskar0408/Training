#filter with lamda and map functions
people=[{"name":"ravi","age":21},{"name":"rekha","age":17},{"name":"swathi","age":18}]#list keys with name and age
under_18=list(filter (lambda x:x ["age"] <18,people))#use list to fliter and lamda function to compare age
above_18=list(filter (lambda x:x["age"]>=18,people))#use list to fliter and lamda function to compare age
print(under_18)#just check 
print(above_18)#just to check
under18_list=list(map(lambda x:(x["name"],x["age"]),under_18))#map function mapping with and age
above18_list=list(map(lambda x:(x["name"],x["age"]),above_18))#map function mapping with and age
print("under 18:",under18_list)
print("above 18:",above18_list)

#multiplying using reduce and lambda function
from functools import reduce #we can not use reduce directly so we import that from functools module
numbers=[1,2,3,4,5,6]#declaring list
product = reduce(lambda a, b: a * b, numbers)#product by using reduce and lamda
print(product)

